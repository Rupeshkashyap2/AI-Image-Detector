# Copy to backend/.env and edit. Never commit .env.
MODEL_PATH=saved_models/efficientnet_best.pth
DEVICE=auto
MAX_UPLOAD_MB=10
MIN_IMAGE_SIDE=128
MAX_IMAGE_PIXELS=50000000
# Placeholder, not calibrated yet. We will calibrate it on the validation set after retraining.
UNCERTAIN_THRESHOLD=0.90
# Warn when an image is reduced by more than this factor (0 disables the warning).
DOWNSCALE_WARN_FACTOR=2.0
HEATMAP_ALPHA=0.4
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173